{
  "manifest_version": 3,
  "name": "Conjure: prompt studio",
  "version": "1.0.0",
  "description": "Draft and refine image prompts. Copy into your image tool or place text into the Midjourney prompt field.",
  "permissions": ["storage"],
  "host_permissions": ["https://conjure-two.vercel.app/*"],
  "content_scripts": [
    {
      "matches": ["https://www.midjourney.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["panel/index.html", "panel.js", "assets/*"],
      "matches": ["https://www.midjourney.com/*"]
    }
  ]
}
