{
  "name": "conjure",
  "private": true,
  "scripts": {
    "build": "pnpm lint:icons && pnpm test:icons && turbo build",
    "dev": "turbo dev",
    "lint": "pnpm lint:icons && pnpm test:icons && turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean",
    "lint:icons": "node site-quality/lint-icons.mjs --root apps",
    "test:icons": "node --test site-quality/icons.test.mjs",
    "test": "node --test tests/*.test.ts"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
