{
  "name": "conjure",
  "private": true,
  "scripts": {
    "build": "pnpm lint:icons && pnpm test:icons && turbo build",
    "dev": "turbo dev",
    "lint": "pnpm lint:icons && pnpm test:icons && turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean",
    "lint:icons": "node site-quality/lint-icons.mjs --root apps",
    "test:icons": "node --test site-quality/icons.test.mjs",
    "test": "node --test tests/*.test.ts",
    "test:auth-compat": "pnpm --filter @conjure/web exec node --test tests/auth-compat.test.mjs"
  },
  "devDependencies": {
    "turbo": "^2.11.13",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "next@15.5.29>postcss": "8.5.33",
      "@prisma/config@6.19.3>effect": "3.22.1"
    },
    "packageExtensions": {
      "better-call@1.4.6": {
        "dependencies": {
          "zod": "4.6.7"
        }
      }
    }
  }
}
